# Copy to .env.local for local development. Do not commit .env.local.
# Vite reads these at build time and exposes only NEXT_PUBLIC_ values to the browser.
# Never put a service-role key in a NEXT_PUBLIC_ or VITE_ variable.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
